{
  "name": "return-to-me",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "generate:icons": "node scripts/generate-icons.mjs",
    "voices:check": "tsx scripts/import-voices.ts --dry-run",
    "voices:import": "tsx scripts/import-voices.ts",
    "voices:dev:plan": "tsx scripts/export-dev-voice-jobs.ts",
    "voices:dev:sapi:proof": "npm run voices:dev:plan && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-sapi-dev-voices.ps1 -ProofOnly",
    "voices:dev:sapi": "npm run voices:dev:plan && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-sapi-dev-voices.ps1",
    "voices:dev:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-dev-voices.ps1",
    "build": "npm run validate && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "validate": "npm run validate:content",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:deploy": "tsx scripts/validate-content.ts --deploy",
    "validate:release": "tsx scripts/validate-content.ts --require-voices",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:app": "npm run lint && npm run typecheck && npm run validate && npm run test && npm run build",
    "check": "npm run check:app && npm run test:e2e"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
